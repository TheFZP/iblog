# ========= 通用 =========
*.log
# 重定向日志会带上 .out/.err 后缀，*.log 匹配不到
*.log.*
logs/
# 临时工作目录（走查脚本、数据库导出等，含线上数据，绝不提交）
.workbuddy/
.shots/
.DS_Store
Thumbs.db

# ========= 环境变量 =========
.env
.env.local
# 发布脚本的目标服务器配置（含服务器地址，不要提交）
.release.env
# 本地开发私密配置：application-local.yml 里写着线上库地址与密码。
# 注意 *.local 匹配不到 *.local.yml（后缀是 .yml 不是 .local），必须单独写一行。
application-local.yml

# ========= Node / 前端 =========
node_modules/
node_modules.*.bak/
dist/
dist-ssr/
# 同步脚本的备份目录（含线上数据，不要提交）
deploy/.sync-backup/

# 本地预构建产物（由 deploy/build-local.sh 生成，不要提交）
deploy/dist/
.vite/
.pnpm-store/
*.local
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ========= Java / Gradle =========
.gradle/
# build-local.sh 在默认 GRADLE_USER_HOME 不可用时的兜底缓存目录
.gradle-local-home/
build/
target/
*.class
*.jar
*.war
*.ear
# Gradle Wrapper 的 jar 必须提交，否则别人 clone 后无法构建
!gradle/wrapper/gradle-wrapper.jar
hs_err_pid*
replay_pid*

# ========= IDE =========
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.classpath
.project
.apt_generated
.factorypath
.springBeans
.sts4-cache
