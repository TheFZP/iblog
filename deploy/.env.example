# 复制为 .env 后按需修改：cp .env.example .env

# MySQL root 密码（务必修改）
MYSQL_ROOT_PASSWORD=iblog@2026

# JWT 签名密钥，长度必须 >= 32 字符（务必修改，可用 openssl rand -base64 48 生成）
IBLOG_JWT_SECRET=iblog-personal-blog-jwt-secret-key-please-change-me-2026

# 官网「行情」登录态 Cookie
# 线上通过 HTTPS 访问，必须为 true；只有本地 http 调试才改 false
IBLOG_COOKIE_SECURE=true
# 官网与后台是同一主域的不同子域时填主域（如 example.com），留空表示仅当前主机
# （同一主机的不同端口浏览器会自动共享 Cookie，无需填）
IBLOG_COOKIE_DOMAIN=

# 自动交易总开关：默认 false（手动模拟买卖可用，自动选股 / 自动交易不跑）
# 打开后用户还需在 /paper 页面点「自动交易」才会替该用户自动下单
IBLOG_PAPER_ENABLED=false
# 新建 / 重置模拟盘账户的初始资金
IBLOG_PAPER_INITIAL_CASH=1000000
# 每个用户最多可建的模拟盘数量（多账户对比不同选股规则）
IBLOG_PAPER_MAX_ACCOUNTS=5
# 额外休市日，逗号分隔，如 2026-10-01,2026-10-02
IBLOG_PAPER_HOLIDAYS=

# 对外端口
WEB_PORT=80
ADMIN_PORT=81
SERVER_PORT=8080

# 后端 JVM 参数
# 2 核 2G 服务器：-Xms128m -Xmx384m -XX:+UseSerialGC（SerialGC 比 G1 省内存）
# 4G 及以上：可换回 -Xms256m -Xmx512m -XX:+UseG1GC
JAVA_OPTS=-Xms128m -Xmx384m -XX:+UseSerialGC

# =============================================================
#  构建模式（二选一）
# =============================================================

# ---- 模式 A：源码构建（默认，服务器上编译，需 4G 内存或 2G+Swap）----
SERVER_BUILD_CONTEXT=../iblog-server
SERVER_DOCKERFILE=Dockerfile
ADMIN_BUILD_CONTEXT=../iblog-admin
ADMIN_DOCKERFILE=Dockerfile
WEB_BUILD_CONTEXT=../iblog-web
WEB_DOCKERFILE=Dockerfile
DB_INIT_DIR=../iblog-server/src/main/resources/db

# ---- 模式 B：本地预构建（2 核 2G 推荐）----
# 先在本机执行 `bash deploy/build-local.sh` 生成 deploy/dist/，再上传整个 deploy 目录到服务器，
# 然后把上面模式 A 的 7 行注释掉、下面 7 行放开。服务器只做 COPY，构建几秒完成、几乎不吃内存。
# SERVER_BUILD_CONTEXT=./dist/server
# SERVER_DOCKERFILE=Dockerfile
# ADMIN_BUILD_CONTEXT=./dist/admin
# ADMIN_DOCKERFILE=Dockerfile
# WEB_BUILD_CONTEXT=./dist/web
# WEB_DOCKERFILE=Dockerfile
# DB_INIT_DIR=./dist/db
