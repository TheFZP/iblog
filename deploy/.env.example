# 复制为 .env 后按需修改：cp .env.example .env

# MySQL root 密码（务必修改）
MYSQL_ROOT_PASSWORD=iblog@2026

# JWT 签名密钥，长度必须 >= 32 字符（务必修改，可用 openssl rand -base64 48 生成）
IBLOG_JWT_SECRET=iblog-personal-blog-jwt-secret-key-please-change-me-2026

# 对外端口
WEB_PORT=80
ADMIN_PORT=81
SERVER_PORT=8080

# 后端 JVM 参数
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC
